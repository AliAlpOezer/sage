# Required
OPENROUTER_API_KEY_1=sk-or-...
# OPENROUTER_API_KEY_2=sk-or-...
# ...as many numbered keys as you have. On a 429 the generator, embedder and
# RAGAS judge switch to the next number; after the last one they wrap back to
# OPENROUTER_API_KEY_1. Note OpenRouter says extra keys/accounts do not raise
# its rate limits, so this only helps if your keys are limited separately.

# Component selection (factory keys) — defaults shown
# SAGE_CHUNKER=recursive
# SAGE_CHUNK_MAX_CHARS=1800
# SAGE_CHUNK_OVERLAP_CHARS=200
# SAGE_EMBEDDER=openrouter
# SAGE_EMBED_BATCH_SIZE=128
# SAGE_EMBED_CONCURRENCY=8
# SAGE_FETCH_CONCURRENCY=8
# SAGE_EMBEDDING_MODEL=openai/text-embedding-3-small
# SAGE_VECTOR_STORE=qdrant
# SAGE_QDRANT_PATH=data/qdrant
# SAGE_COLLECTION=langchain-docs
# SAGE_GENERATOR=omniroute           # omniroute | openrouter
# SAGE_GENERATION_MODEL=             # empty = the generator's default model
# SAGE_GENERATION_MAX_TOKENS=4000
# SAGE_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
#   ^ OmniRoute is a local, keyless, OpenAI-compatible gateway that pools several
#     providers' free endpoints behind one endpoint with its own auto-fallback:
#         npm i -g omniroute
#         omniroute serve --daemon --no-open --no-tray
#     (~30s cold start, ~263MB resident). Only its virtual `auto/*:free` combo
#     routes resolve — every explicitly named upstream 401s — and only those are
#     used, so nothing can silently select a paid proxy route. Keep the token
#     ceiling generous: the upstreams are reasoning models that spend it thinking
#     before the answer starts, and a truncated reply reads as an empty completion.
#     SAGE_GENERATOR=openrouter still works when a specific named model matters.
#     Question embedding always uses the paid SAGE_EMBEDDING_MODEL above (cheap,
#     but needs OpenRouter credit) — OmniRoute's free pool is chat-only.
# SAGE_TOP_K=5

# --- Evals (RAGAS judge) ---
# The judge LLM scores the four RAGAS metrics. OpenRouter's FREE tier caps at
# 8 req/min — too slow for RAGAS (15 min / 2 samples, all NaN). The default is the
# same local OmniRoute gateway as the generator: no key, no per-key quota.
# Embeddings always go through OpenRouter (tiny paid call).
# SAGE_JUDGE_PROVIDER=omniroute       # omniroute | openrouter | groq | gemini
# SAGE_JUDGE_MODEL=                  # empty = the provider's default model
# SAGE_JUDGE_MAX_TOKENS=4000
# GROQ_API_KEY=gsk_...               # free at console.groq.com (no card)
# GEMINI_API_KEY=...                 # free at aistudio.google.com (if provider=gemini)

# Corpus
# Remote Qdrant (server or Qdrant Cloud) instead of the embedded store at SAGE_QDRANT_PATH:
# SAGE_QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
# QDRANT_API_KEY=...

# Comma-separated doc sites to ingest, from src/sage/sources.py:
# langchain | langfuse | qdrant | neo4j | neo4j-graphrag | ragas. The evals always use langchain only.
# SAGE_SOURCES=langchain
# Fetched pages are cached here and reused by later ingests. Delete the directory
# to re-fetch changed docs; set it empty to turn the cache off.
# SAGE_PAGE_CACHE=data/pages
