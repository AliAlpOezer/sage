# Required
OPENROUTER_API_KEY=sk-or-...

# Component selection (factory keys) — defaults shown
# SAGE_CHUNKER=recursive
# SAGE_CHUNK_MAX_CHARS=1800
# SAGE_CHUNK_OVERLAP_CHARS=200
# SAGE_EMBEDDER=openrouter
# SAGE_EMBED_BATCH_SIZE=128
# SAGE_EMBED_CONCURRENCY=8
# SAGE_FETCH_CONCURRENCY=8
# SAGE_EMBEDDING_MODEL=openai/text-embedding-3-small
# SAGE_VECTOR_STORE=qdrant
# SAGE_QDRANT_PATH=data/qdrant
# SAGE_COLLECTION=langchain-docs
# SAGE_GENERATOR=openrouter
# SAGE_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   ^ a :free model = no per-token cost, but free providers are rate-limited
#     upstream and the id set rotates over time. Question embedding still uses
#     the paid SAGE_EMBEDDING_MODEL above (cheap, but needs OpenRouter credit).
# SAGE_TOP_K=5

# --- Evals (RAGAS judge) ---
# The judge LLM scores the four RAGAS metrics. OpenRouter's FREE tier caps at
# 8 req/min — too slow for RAGAS (15 min / 2 samples, all NaN). Use a provider with a
# real free tier instead. Embeddings always go through OpenRouter (tiny paid call).
# SAGE_JUDGE_PROVIDER=groq            # openrouter | groq | gemini
# SAGE_JUDGE_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...               # free at console.groq.com (no card)
# GEMINI_API_KEY=...                 # free at aistudio.google.com (if provider=gemini)

# Corpus
# SAGE_DOCS_INDEX_URL=https://docs.langchain.com/sitemap.xml
# SAGE_DOCS_URL_PREFIX=https://docs.langchain.com/oss/python/
