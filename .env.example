# Required
OPENROUTER_API_KEY=sk-or-...

# Component selection (factory keys) — defaults shown
# SAGE_CHUNKER=recursive
# SAGE_CHUNK_MAX_CHARS=1800
# SAGE_CHUNK_OVERLAP_CHARS=200
# SAGE_EMBEDDER=openrouter
# SAGE_EMBED_BATCH_SIZE=128
# SAGE_EMBED_CONCURRENCY=8
# SAGE_FETCH_CONCURRENCY=8
# SAGE_EMBEDDING_MODEL=openai/text-embedding-3-small
# SAGE_VECTOR_STORE=qdrant
# SAGE_QDRANT_PATH=data/qdrant
# SAGE_COLLECTION=langchain-docs
# SAGE_GENERATOR=openrouter
# SAGE_GENERATION_MODEL=anthropic/claude-sonnet-4-6
# SAGE_TOP_K=5

# Corpus
# SAGE_DOCS_INDEX_URL=https://docs.langchain.com/sitemap.xml
# SAGE_DOCS_URL_PREFIX=https://docs.langchain.com/oss/python/
